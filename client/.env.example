# Copy to .env.local for local dev (never commit .env.local)
# In Vercel: set these under Project Settings -> Environment Variables

# Go server base URL. Local dev default matches server/main.go's port.
VITE_API_URL=http://localhost:8080

# Supabase (fill in once the project exists)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
